class Game {
    private int score;
    public void addPoints(int n) {
        if (n > 0) {
            this.score = this.score + n;
        } else {
            this.score = 0;
        }
    }
    public void countdown(int from) {
        while (from > 0) {
            from = from - 1;
        }
    }
    public int sumUpTo(int n) {
        int total = 0;
        for (int i = 0; i <= n; i++) {
            total = total + i;
        }
        return total;
    }
}
